RewriteEngine on
RewriteCond %{HTTP_HOST} ^https://socializaplus.com.brr$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www.socializaplus.com.br$
RewriteCond %{REQUEST_URI} !public/
RewriteRule (.*) /public/$1 [L]

